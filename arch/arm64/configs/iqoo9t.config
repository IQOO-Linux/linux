# iQOO 9T (SM8475 "cape") bring-up fragment, on top of arm64 defconfig.
#
# Everything the milestone-1 payload needs must be built in: the initramfs has
# no modules, and the only console is a USB gadget.

CONFIG_SM_GCC_8450=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_PINCTRL_SM8450=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_TSENS=y
CONFIG_ARM_SMMU=y
CONFIG_INTERCONNECT_QCOM_SM8450=y

# UFS root
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_QCOM_INLINE_CRYPTO_ENGINE=y
CONFIG_EXT4_FS=y

# USB peripheral: DWC3 + eUSB2 HS PHY + configfs gadget (ACM console, NCM net)
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_PHY_SNPS_EUSB2=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_F_ACM=y
CONFIG_USB_F_NCM=y

# Keep the ABL splash scanning out as a text console (no panel driver yet)
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Blind-boot log capture
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y

# Cortex-X2 (SM8475) has no FEAT_LPA2; 52-bit VA/LPA2 hangs before console.
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_ARM64_VA_BITS_52 is not set
CONFIG_ARM64_PA_BITS_48=y
# CONFIG_ARM64_PA_BITS_52 is not set
# CONFIG_ARM64_LPA2 is not set
